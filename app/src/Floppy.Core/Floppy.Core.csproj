<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Floppy.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport (SetErrorMode) erzeugt Marshalling-Code, der das verlangt. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Gemeinsame Regeln fuer Floppy Hub: game.txt, Sicherheit, INI, Bibliothek.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Floppy.Core.Tests" />
  </ItemGroup>

</Project>
